{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true
  },
  "include": ["src/**/*", "settings.json","src/**/*.ts",
    "scripts/**/*.ts", "scripts/copy-paste.ts"],
  "exclude": ["node_modules", "dist"]
}